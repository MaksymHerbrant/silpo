# ============ Telegram ============
# BotFather -> /newbot -> токен. Далі /newapp (або /setmenubutton) -> Web App.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=nutrikoshyk_bot        # без @
TELEGRAM_WEBAPP_SHORT_NAME=app               # t.me/<bot>/<app>
TELEGRAM_INITDATA_MAX_AGE=86400

# ============ Сесія Mini App ============
# openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=43200

# ============ Supabase ============
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — ТІЛЬКИ на бекенді, ніколи у фронтенді
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ============ Шифрування MCP-токенів ============
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ============ MCP Сільпо ============
SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# client_id НЕ потрібен: Сільпо підтримує Dynamic Client Registration (RFC 7591),
# бекенд сам реєструється на POST https://mcp.silpo.ua/register і кешує результат.
# Заповнюй, лише якщо тобі видали статичні креденшели.
SILPO_OAUTH_CLIENT_ID=
SILPO_OAUTH_CLIENT_SECRET=
SILPO_OAUTH_SCOPE=
SILPO_OAUTH_ISSUER=https://mcp.silpo.ua
# Заповнюй, лише якщо RFC 8414 discovery не працює. Фактичні значення (перевірено):
#   authorize = https://mcp.silpo.ua/authorize
#   token     = https://mcp.silpo.ua/token
SILPO_OAUTH_AUTHORIZE_URL=
SILPO_OAUTH_TOKEN_URL=

# Публічні URL (redirect_uri OAuth будується як <PUBLIC_BACKEND_URL>/auth/silpo/callback)
PUBLIC_BACKEND_URL=https://your-backend.example.com
PUBLIC_FRONTEND_URL=https://your-frontend.example.com

# ============ Anthropic (тільки текстові пояснення) ============
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
ENABLE_LLM_EXPLANATIONS=true

# ============ Режими ============
# true -> MCP підміняється фікстурами (розробка UI без живого акаунта)
DEMO_MODE=false
CORS_ORIGINS=*

# ============ Rate limit MCP ============
MCP_MIN_INTERVAL_MS=250
MCP_MAX_RETRIES=5
MCP_BACKOFF_BASE_MS=500

# ============ Фронтенд (Vite) ============
VITE_API_BASE_URL=https://your-backend.example.com
